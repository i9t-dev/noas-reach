<?xml version="1.0"?>
<extension key="noas-reach" type="module">
  <file>noas_reach</file>
  <name>NoasReach</name>
  <description>Refined search extension for CiviCRM entities</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Christophe Pel&#xE9;</name>
      <email>cp@i9t.fr</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://i9t-dev.github.io/noas-reach</url>
    <url desc="Documentation">https://github.com/i9t-dev/noas-reach/blob/main/README.md</url>
    <url desc="Support">https://github.com/i9t-dev/noas-reach/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
    <url desc="App Page">/civicrm/find-contents</url>
  </urls>
  <releaseDate>2026-11-16</releaseDate>
  <version>0.1.1+cohesive-shrimp</version>
  <develStage>alpha</develStage>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/NoasReach</namespace>
    <format>25.10.2</format>
    <angularModule>crmNoasReach</angularModule>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\NoasReach\AutomaticUpgrader</upgrader>
</extension>
